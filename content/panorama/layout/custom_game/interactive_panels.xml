<root>
    <scripts>   
		<include src="file://{resources}/scripts/custom_game/interactive_panel.js"/>
    </scripts>
    <styles>
        <include src="file://{resources}/styles/custom_game/last_hit_trainer.css"/>
		<include src="s2r://panorama/styles/dotastyles.css" />
    </styles>
    <Panel hittest="false" class="CustomHudRoot">
		<Panel id="InfoScreen" class="Visible">
			<Panel class="InfoTextBox">
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Kill percentage"></Label>
					</Panel>
					<Panel class="value">
						<Label id="CreepsKilled" text="%" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Denied experience"></Label>
					</Panel>
					<Panel class="value">
						<Label id="DeniedExp" text="0" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Denied gold"></Label>
					</Panel>
					<Panel class="value">
						<Label id="DeniedGold" text="0" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Gained experience"></Label>
					</Panel>
					<Panel class="value">
						<Label id="GainedExp" text="0" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Gained gold"></Label>
					</Panel>
					<Panel class="value">
						<Label id="GainedGold" text="0" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Level difference"></Label>
					</Panel>
					<Panel class="value">
						<Label id="GainedGold" text="levels" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Gold difference"></Label>
					</Panel>
					<Panel class="value">
						<Label id="GainedGold" text="gold" />
					</Panel>
				</Panel>
				
				<Panel class="Figure" id="Graph1">
				</Panel>
				<Panel class="Figure2" id="Graph2" >
				</Panel>
			</Panel>
			<Panel class="LastHitTrainerPanel" id="LastHitTrainerPanel">
				<Panel class="horizontal_container score">
					<Panel class="label">
						<Label text="#DOTA_HUD_Score" />
					</Panel>
					<Panel class="value">
						<Label id="Score" text="hit/all" />
					</Panel>
				</Panel>
			</Panel>
		</Panel>
        <Panel hittest="false" id="ControlPanel">
			<Panel class="ControlPanelContainer">
				<Panel id="Maximized">
					<Panel class="BorderTitle">
						<Label text="#Flyout_Panel_Title" />
						<Panel id="ControlPanelSlideThumbContainer" require-composition-layer="true">
							<Button id="ControlPanelSlideThumb" acceptsjoyfocus="true" onactivate="SlideThumbActivate()">
								<Panel class="RightArrowButtonIcon" />
							</Button>
						</Panel>
					</Panel>
					<Panel class="Category">
						<Label text="" />
						<Button class="DemoButton" onactivate="$.DispatchEvent(&apos;FireCustomGameEvent_Str&apos;, &apos;RoundRestartButtonPressed&apos;, &apos;&apos; );">
							<Label text="#Flyout_Restart_Round_Button" />
						</Button>
						<Button id="NewHeroButton" class="DemoButton" onactivate="ToggleHeroPicker()">
							<Label text="#Flyout_Choose_New_Hero_Button" />
						</Button>
						<Panel class="NemesisSetting">
							<Label text="Bot attack speed"></Label>
						</Panel>
						<Panel class="NemesisSetting" id="NemesisSettingButtons">
							<Button id="ButtonMinus" class="SettingButton" 
								onmousedown="Start_AttackSpeedChange(-1)"
								onmouseup="Stop_AttackSpeedChange()"
								onmouseout="Stop_AttackSpeedChange()">
								<Label text="-"/>
							</Button>
							<Panel class="Text">
								<Label id="AttackSpeedTextBox" text="text" />
							</Panel>
							<Button id="ButtonPlus" class="SettingButton"
								onmousedown="Start_AttackSpeedChange(1)"
								onmouseup="Stop_AttackSpeedChange()"
								onmouseout="Stop_AttackSpeedChange()">
								<Label  text="+"/>
							</Button>
						</Panel>
						<ToggleButton class="OptionsToggleButton" acceptsjoyfocus="true" onactivate="FireCustomGameEvent_Str( HighlightCreepsButtonPressed )">
							<Label text="Highlight creeps"></Label>
						</ToggleButton>
						<ToggleButton class="OptionsToggleButton" acceptsjoyfocus="true" onactivate="FireCustomGameEvent_Str( EnableExperienceButtonPressed )">
							<Label text="Enable experience"></Label>
						</ToggleButton>
						<ToggleButton class="OptionsToggleButton" acceptsjoyfocus="true" onactivate="NemesisModeActivate()">
							<Label text="Nemesis mode"></Label>
						</ToggleButton>
					</Panel>
					<Panel class="Category">
						<Label text="" />
						<Panel class="QuitPanel">
							<Button class="QuitButton" onactivate="FireCustomGameEvent_Str( LeaveButtonPressed )">
								<Label text="#Quit_Button" />
							</Button>
						</Panel>
					</Panel>
				</Panel>
			</Panel>
			<Panel id="SelectHeroContainer">
				<DOTAUIHeroPicker id="HeroPicker" />
			</Panel>
			
		</Panel>
		
    </Panel>
</root>