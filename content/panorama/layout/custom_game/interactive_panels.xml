<root>
    <scripts>   
		<include src="file://{resources}/scripts/custom_game/interactive_panel.js"/>
		<include src="file://{resources}/scripts/custom_game/plotting.js"/>
    </scripts>
    <styles>
        <include src="file://{resources}/styles/custom_game/last_hit_trainer.css"/>
		<include src="file://{resources}/styles/custom_game/info_panel.css"/>
		<include src="file://{resources}/styles/custom_game/advanced_setting.css"/>
		<include src="s2r://panorama/styles/dotastyles.css" />
    </styles>
    <Panel hittest="false" class="CustomHudRoot">
        <Panel id="ControlPanel">
			<Panel class="ControlPanelContainer">
				<Panel id="Maximized">
					<Panel class="BorderTitle">
						<Label text="#Flyout_Panel_Title" />
						<Panel id="ControlPanelSlideThumbContainer" require-composition-layer="true">
							<Button id="ControlPanelSlideThumb" acceptsjoyfocus="true" onactivate="SlideThumbActivate()">
								<Panel class="RightArrowButtonIcon" />
							</Button>
						</Panel>
					</Panel>
					<Panel class="Category">
						<Label text="" />
						<Button class="DemoButton" onactivate="$.DispatchEvent(&apos;FireCustomGameEvent_Str&apos;, &apos;RoundRestartButtonPressed&apos;, &apos;&apos; );">
							<Label text="#Flyout_Restart_Round_Button" />
						</Button>
						<Button id="NewHeroButton" class="DemoButton" onactivate="ToggleHeroPicker()">
							<Label text="#Flyout_Choose_New_Hero_Button" />
						</Button>
						<Button class="DemoButton" onactivate="OpenInfoScreen()">
							<Label text="Round Statistics" />
						</Button>
						<Button class="DemoButton" onactivate="ToggleAdvancedSettings()">
							<Label text="Advanced Settings" />
						</Button>
					</Panel>
					<Panel class="Category">
						<Label text="" />
						<Panel class="QuitPanel">
							<Button class="QuitButton" onactivate="FireCustomGameEvent_Str( LeaveButtonPressed )">
								<Label text="#Quit_Button" />
							</Button>
						</Panel>
					</Panel>
				</Panel>
			</Panel>
			<Panel id="SelectHeroContainer">
				<DOTAUIHeroPicker id="HeroPicker" />
			</Panel>
			<Panel id="AdvancedScreen" class="Invisible">
				<Panel class="AdvancedTitleContainer">
					<Panel class="AdvancedTitle">
						<Panel class="label">
							<Label text="Advanced Settings" />
						</Panel>
					</Panel>
				</Panel>
				<Panel class="AdvancedTextBox">
					<Panel class="horizontal_container">
						<ToggleButton class="AdvancedOptionsToggleButton" acceptsjoyfocus="true" onactivate="FireCustomGameEvent_Str( HighlightCreepsButtonPressed )">
							<Label text="Highlight creeps"></Label>
						</ToggleButton>
						<ToggleButton class="AdvancedOptionsToggleButton" acceptsjoyfocus="true" onactivate="FireCustomGameEvent_Str( EnableExperienceButtonPressed )">
							<Label text="Enable experience"></Label>
						</ToggleButton>
					</Panel>
					<Panel class="horizontal_container">
						<ToggleButton class="AdvancedOptionsToggleButton" acceptsjoyfocus="true" onactivate="NemesisModeActivate()">
							<Label text="Nemesis mode"></Label>
						</ToggleButton>
						<ToggleButton class="AdvancedOptionsToggleButton" acceptsjoyfocus="true" onactivate="FireCustomGameEvent_Str( NemesisEnabled )">
							<Label text="Bot enable"></Label>
						</ToggleButton>
					</Panel>
					<Panel class="horizontal_container">
						<ToggleButton id="DireSiegeButton" class="AdvancedOptionsToggleButton" acceptsjoyfocus="true" onactivate="FireCustomGameEvent_Str( DisableDireSiegeCreepsButtonPressed )">
							<Label text="Dire siege"></Label>
						</ToggleButton>
						<ToggleButton id="RadiantSiegeButton" class="AdvancedOptionsToggleButton" acceptsjoyfocus="true" onactivate="FireCustomGameEvent_Str( DisableRadiantSiegeCreepsButtonPressed )">
							<Label text="Radiant siege"></Label>
						</ToggleButton>
					</Panel>
					<Panel class="horizontal_container">
						<ToggleButton id="DireRangedButton" class="AdvancedOptionsToggleButton" acceptsjoyfocus="true" onactivate="FireCustomGameEvent_Str( DisableDireRangedCreepsButtonPressed )">
							<Label text="Dire ranged"></Label>
						</ToggleButton>
						<ToggleButton id="RadiantRangedButton" class="AdvancedOptionsToggleButton" acceptsjoyfocus="true" onactivate="FireCustomGameEvent_Str( DisableRadiantRangedCreepsButtonPressed )">
							<Label text="Radiant ranged"></Label>
						</ToggleButton>
					</Panel>
					<Panel class="horizontal_container">
						<ToggleButton id="DireMeleeButton" class="AdvancedOptionsToggleButton" acceptsjoyfocus="true" onactivate="FireCustomGameEvent_Str( DisableDireMeleeCreepsButtonPressed )">
							<Label text="Dire melee"></Label>
						</ToggleButton>
						<ToggleButton id="RadiantMeleeButton" class="AdvancedOptionsToggleButton" acceptsjoyfocus="true" onactivate="FireCustomGameEvent_Str( DisableRadiantMeleeCreepsButtonPressed )">
							<Label text="Radiant melee"></Label>
						</ToggleButton>
					</Panel>
					<Panel class="AdvancedSlider">
						<Label id="DamageThresholdNum" text="Damage threshold: -1" />
						<Slider
							class="HorizontalSlider"
							direction= "Horizontal"
							id="DamageSlider"
							onvaluechanged="DamageThresholdValueChanged()"/>
					</Panel>
					<Panel class="AdvancedSlider">
						<Label id="AttackSpeedNum" text="Bot attack speed: 0" />
						<Slider
							class="HorizontalSlider"
							direction= "Horizontal"
							id="AttackSpeedSlider"
							onvaluechanged="AttackSpeedValueChanged()"/>
					</Panel>
					<Panel class="horizontal_container CenteredSection">
						<Button class="AdvancedButton" onactivate="FireCustomGameEvent_Str(LevelUpButtonPressed)">
							<Label text="Level up" />
						</Button>
						<Button class="AdvancedButton" onactivate="FireCustomGameEvent_Str(ResetLevelButtonPressed)">
							<Label text="Reset level" />
						</Button>
					</Panel>
					<Panel class="horizontal_container CenteredSection">
						<Panel class="AdvancedNemesisSetting">
							<Label text="Timed practice"></Label>
						</Panel>
						<Panel class="AdvancedNemesisSetting">
							<Label text="Game speed"></Label>
						</Panel>
					</Panel>
					<Panel class="horizontal_container CenteredSection" >

						<Panel class="AdvancedNemesisSetting" id="TimedPractice">
							<Button id="ButtonMinus" class="SettingButton" 
								onmousedown="TimedPracticeChange(-1)">
								<Label text="-"/>
							</Button>
							<Panel class="Text">
								<Label id="TimedPracticeTextBox" text="0:30" />
							</Panel>
							<Button id="ButtonPlus" class="SettingButton"
								onmousedown="TimedPracticeChange(1)">
								<Label  text="+"/>
							</Button>
						</Panel>
						<Panel class="AdvancedNemesisSetting" id="GameSpeed">
							<Button id="ButtonMinus" class="SettingButton" 
								onmousedown="GameSpeedChange(-1)">
								<Label text="-"/>
							</Button>
							<Panel class="Text">
								<Label id="GameSpeedTextBox" text="1" />
							</Panel>
							<Button id="ButtonPlus" class="SettingButton"
								onmousedown="GameSpeedChange(1)">
								<Label  text="+"/>
							</Button>
						</Panel>
						
					</Panel>
					<Panel class="horizontal_container CenteredSection" >
						<Button class="AdvancedButton" onactivate="FireCustomGameEvent_Str(StartTimedPracticeButtonPressed)">
							<Label text="Start practice" />
						</Button>
						<Button id="NewEnemyHeroButton" class="AdvancedButton" onactivate="ToggleEnemyHeroPicker()">
							<Label text="Choose New Bot" />
						</Button>
					</Panel>
					
				</Panel>
			</Panel>
			
		</Panel>
		<Panel id="InfoScreen" class="Invisible">
            <Panel class="TitleContainer">
                <Panel class="Title">
                    <Panel class="label">
                        <Label text="Current lasthit statistics" />
                    </Panel>
                </Panel>
                <Panel id="InfoPanelCancelContainer" require-composition-layer="true">
                    <Button id="InfoPanelButton" acceptsjoyfocus="true" onactivate="CloseInfoScreen()">
                        <Panel class="CrossButtonIcon" />
                    </Button>
                </Panel>
            </Panel>
			<Panel class="InfoTextBox">
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Kill percentage"></Label>
					</Panel>
					<Panel class="value">
						<Label id="KilledPercentage" text="%" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Denied experience"></Label>
					</Panel>
					<Panel class="value">
						<Label id="DeniedExp" text="0" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Denied gold"></Label>
					</Panel>
					<Panel class="value">
						<Label id="DeniedGold" text="0" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Secured experience"></Label>
					</Panel>
					<Panel class="value">
						<Label id="GainedExp" text="0" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Secured gold"></Label>
					</Panel>
					<Panel class="value">
						<Label id="GainedGold" text="0" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Lost experience"></Label>
					</Panel>
					<Panel class="value">
						<Label id="ExpLoss" text="xp" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Lost gold"></Label>
					</Panel>
					<Panel class="value">
						<Label id="GoldLoss" text="gold" />
					</Panel>
				</Panel>
				<Panel class="horizontal_container">
					<Panel class="label">
						<Label text="Lasthit delay over time:"></Label>
					</Panel>
				</Panel>
				<Panel class="GraphArea" id="TestGraph" >
				</Panel>
				<Panel id="GraphTooltip" class="GraphTooltip" visible="false">
					<Label id="GraphTooltipLabel" />
				</Panel>

			</Panel>
		</Panel>
		
    </Panel>
</root>